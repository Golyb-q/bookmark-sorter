  "features": [
    {
      "id": "accounts",
      "text": "У сервиса есть устойчивые пользовательские аккаунты, важные для его работы?",
      "weight": 1
    },
    {
      "id": "profiles",
      "text": "Публичные профили пользователей или авторов — заметная часть структуры сервиса?",
      "weight": 1
    },
    {
      "id": "social_graph",
      "text": "Есть явные связи между людьми: друзья, подписки или followers?",
      "weight": 1
    },
    {
      "id": "private_messages",
      "text": "Есть личные сообщения или приватные диалоги между людьми?",
      "weight": 1
    },
    {
      "id": "communities",
      "text": "Есть устойчивые группы, сообщества, серверы, форумы или каналы с участниками?",
      "weight": 1
    },
    {
      "id": "public_posts",
      "text": "Пользователи регулярно публикуют самостоятельные публичные посты или материалы?",
      "weight": 1
    },
    {
      "id": "personal_feed",
      "text": "Есть персональная лента, собираемая из подписок или рекомендаций?",
      "weight": 1
    },
    {
      "id": "comments",
      "text": "Комментарии и обсуждения вокруг публикаций — заметная часть сервиса?",
      "weight": 0.8
    },
    {
      "id": "content_corpus",
      "text": "Внутри есть большой устойчивый корпус материалов, который можно долго просматривать независимо от своего аккаунта?",
      "weight": 1.2
    },
    {
      "id": "media_first",
      "text": "Основная масса материалов — изображения, видео или аудио?",
      "weight": 1
    },
    {
      "id": "knowledge_first",
      "text": "Основная масса материалов — справочные, учебные, энциклопедические или документирующие тексты?",
      "weight": 1
    },
    {
      "id": "create_objects",
      "text": "Пользователь создаёт собственные долгоживущие объекты: проекты, документы, репозитории, доски и т.п.?",
      "weight": 1
    },
    {
      "id": "collab_edit",
      "text": "Есть совместное редактирование или совместная работа над одними и теми же объектами?",
      "weight": 1
    },
    {
      "id": "ai_dialog",
      "text": "Главное взаимодействие — диалог с программным агентом или персонажем?",
      "weight": 1.4
    },
    {
      "id": "game_rules",
      "text": "Главное взаимодействие подчиняется правилам игры или симуляции?",
      "weight": 1.4
    },
    {
      "id": "persistent_game",
      "text": "Есть постоянное игровое состояние: профиль, прогресс, рейтинг, мир, инвентарь или история матчей?",
      "weight": 1
    },
    {
      "id": "geospatial",
      "text": "География или карта — основная координата, через которую исследуют содержимое?",
      "weight": 1.3
    },
    {
      "id": "realtime_external",
      "text": "Сервис показывает постоянно меняющееся состояние внешнего реального мира или системы в реальном времени?",
      "weight": 1.2
    },
    {
      "id": "search_core",
      "text": "Поиск или обнаружение уже существующих внешних/внутренних объектов — главная функция сервиса?",
      "weight": 1
    },
    {
      "id": "transform_core",
      "text": "Главная функция — преобразовать предоставленные данные в другую форму, формат, кодировку или представление?",
      "weight": 1.3
    },
    {
      "id": "calculate_core",
      "text": "Главная функция — вычислить новое значение или ответ из введённых данных?",
      "weight": 1.2
    },
    {
      "id": "transfer_core",
      "text": "Главная функция — загрузить, передать, опубликовать или временно разместить файл/ссылку?",
      "weight": 1.2
    },
    {
      "id": "monitor_core",
      "text": "Главная функция — собирать события/метрики во времени и затем показывать результаты наблюдения?",
      "weight": 1.3
    },
    {
      "id": "commerce_core",
      "text": "Товары, продавцы, объявления, цены и сделки образуют ядро сервиса?",
      "weight": 1.3
    },
    {
      "id": "admin_core",
      "text": "Через сервис в основном управляют состоянием другой системы, устройства, сервера, аккаунта или услуги?",
      "weight": 1.3
    }
  ],
