  "questions": {
    "root.view": {
      "id": "root.view",
      "text": "Эта страница показывает набор результатов, который зависит от поиска, фильтра, сортировки, ленты, карты или другого выбранного вида?",
      "yes": "q:view.search?",
      "no": "q:root.operator"
    },
    "root.operator": {
      "id": "root.operator",
      "text": "Этот ресурс устроен как одна ограниченная функция или самостоятельная сессия: ты приходишь выполнить конкретное действие, получить один результат или пройти один опыт, а не перемещаться по устойчивой системе из множества связанных сущностей?",
      "yes": "q:op.find?",
      "no": "q:root.object"
    },
    "root.object": {
      "id": "root.object",
      "text": "Закладка указывает на одну конкретную самостоятельную вещь, а не на место, где находятся другие вещи?",
      "yes": "q:obj.media?",
      "no": "q:root.space"
    },
    "root.space": {
      "id": "root.space",
      "text": "Это устойчивое место внутри более крупного ресурса: канал, профиль, проект, сообщество, раздел или похожая область?",
      "yes": "q:space.project?",
      "no": "q:env.workshop?"
    },
    "env.workshop?": {
      "id": "env.workshop?",
      "text": "В центре ресурса — создание и изменение твоих или командных проектов, документов и других рабочих сущностей?",
      "yes": "f:env.workshop",
      "no": "q:env.market?"
    },
    "env.market?": {
      "id": "env.market?",
      "text": "В центре — товары, объявления, предложения, продавцы и сделки?",
      "yes": "f:env.market",
      "no": "q:env.cabinet?"
    },
    "env.cabinet?": {
      "id": "env.cabinet?",
      "text": "Это в основном твои отношения с одной организацией или сервисом: услуги, счета, настройки, подписка, личные данные?",
      "yes": "f:env.cabinet",
      "no": "q:env.dialog?"
    },
    "env.library?": {
